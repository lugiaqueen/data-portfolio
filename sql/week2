-- ============================================================
-- Week 2: Multi-table JOINs + Aliases
-- Concepts: 3-table INNER JOIN, table aliases, GROUP BY
--           multiple columns, COUNT with alias
-- Platform: ThoughtSpot
-- Date: April 2026
-- Business question: Which investors are associated with
--                    acquired NY-based companies, and how
--                    many acquisitions per investor?
-- ============================================================

SELECT c.name,
I.investor_name,
COUNT(a.company_permalink) as total_acquisitions
FROM tutorial.crunchbase_companies c
INNER JOIN tutorial_crunchbase_investments i
ON c.permalink = i.company_permalink
INNER JOIN tutorial_crunchbase_acquisitions a
ON i.company_permalink= a.company_permalink
WHERE a.company_state_code = 'NY'
GROUP BY 1
ORDER BY 3

-- ============================================================
-- Key concepts from this week:
--
-- 3-table JOIN: chain INNER JOINs sequentially, each connecting
--               via a shared key from the previous table
-- Table aliases: shorthand (c, i, a) to avoid repeating full names
-- GROUP BY 1, 2: group by all non-aggregated SELECT columns
-- COUNT + alias: always name your aggregate columns
-- ON vs WHERE:   ON filters before JOIN, WHERE filters after —
--                matters most on LEFT JOINs to preserve NULL rows
-- ============================================================
